rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && (request.auth.token.email == 'admin.gov@incidentreport.com' || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'System Administrator');
    }
    function canViewCategory(categoryId) {
      return signedIn() && (isAdmin() || categoryId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.categoryIds);
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow write: if isAdmin();
    }
    match /userProfiles/{email} {
      allow create: if request.resource.data.email is string
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && request.resource.data.email == email
        && request.resource.data.password is string
        && request.resource.data.password.size() >= 6;
      allow read: if true;
      allow update, delete: if true;
    }
    match /reports/{reportId} {
      allow create: if true;
      allow read: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }
  }
}
